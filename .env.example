# Copy to .env and adjust. Never commit .env (invariant 5).

# --- database ---
POSTGRES_USER=cctv
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cctv
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Composed by services from the parts above; override only if pointing at an external DB.
DATABASE_URL=postgresql://cctv:change-me-locally@db:5432/cctv

# --- message bus ---
REDPANDA_BROKERS=redpanda:9092
SIGHTINGS_TOPIC=sightings

# --- media ---
MEDIAMTX_HOST=mediamtx
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997

# --- simulator ---
SIM_CAMERA_COUNT=50
SIM_VIDEO_DIR=/data/test-videos
# Seconds of playback offset between consecutive cameras. cam-02 starts this far
# behind cam-01, cam-03 twice as far, and so on, so one clip yields a journey.
SIM_OFFSET_STEP_S=90

# --- routing ---
OSRM_URL=http://osrm:5000

# --- api ---
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- web (build-time) ---
VITE_API_BASE=http://localhost:8000
VITE_MEDIAMTX_BASE=http://localhost:8889

# --- authentication (M8) ---
# Off for local development, so `docker compose up` works with no accounts and
# the acceptance tests run unchanged. Any deployment reachable from a network
# must set this to true.
AUTH_REQUIRED=false
# Signs session tokens. Generate with: openssl rand -hex 32
# With AUTH_REQUIRED=true and this empty, the API refuses to start rather than
# signing with a default — a weak default that "works" is worse than a failure.
AUTH_SECRET=
# Hours, not weeks: a signed token cannot be revoked before it expires.
AUTH_TOKEN_TTL_S=28800

# Passwords for the two seeded accounts. Never defaulted and never committed
# (invariant 5); `scripts/seed_accounts.py` skips an account whose password is
# unset and refuses one shorter than 12 characters.
#   demo     — viewer:   reads everything, writes nothing. The evaluator's login.
#   operator — operator: onboards cameras, watchlists plates, acts on alerts.
DEMO_PASSWORD=
OPERATOR_PASSWORD=

# --- ANPR evidence crops (M5/M6) ---
# Where the workers write one JPEG per sighting; the API mounts it read-only to
# serve them and to embed them in the PDF report.
ANPR_CROP_ROOT=/data/crops

# --- upstream camera grid (the government evaluation feeds) -----------
# Base URL of the Sentinel grid. The catalogue at $SENTINEL_BASE$SENTINEL_CATALOGUE_PATH
# is the only source of which cameras exist. As of 14 Sep 2026 it lists
# [{id, name}] only, so stream URLs come from the documented templates
# (services/adapters/catalogue.py, ENDPOINT_TEMPLATES).
SENTINEL_BASE=https://cctv.corp8.cloud
# Catalogue path, in case the organisers move it. It was /api/ingest until
# September 2026; that now answers 404.
SENTINEL_CATALOGUE_PATH=/cameras.json
SENTINEL_TIMEOUT_S=20
# Prefix for this platform's own reference for those cameras, so the real
# estate cannot collide with the simulated NH-48 farm.
SENTINEL_REF_PREFIX=sentinel
# Department attributed to a camera the catalogue does not label.
SENTINEL_DEFAULT_DEPARTMENT=POLICE

# --- live capture behaviour -------------------------------------------
# Reconnect policy. The integration reference asks for ~2s start, ~30s cap.
CAPTURE_BACKOFF_BASE_S=2.0
CAPTURE_BACKOFF_CAP_S=30.0
CAPTURE_HEALTHY_SESSION_S=30.0
# Decoder complaints while attaching mid-stream are expected until the first
# IDR arrives; these are how many failed reads that is allowed to take.
CAPTURE_JOIN_GRACE_S=10.0
CAPTURE_JOIN_GRACE_READS=150
CAPTURE_STEADY_GRACE_READS=20
# No frame at all for this long is a dead stream. Distinct from an inter-frame
# gap, which is normal.
CAPTURE_STALL_TIMEOUT_S=30.0
CAPTURE_SOCKET_TIMEOUT_S=15.0
# Loop-point detection: PTS running backwards or leaping forwards.
CAPTURE_PTS_REGRESSION_S=1.0
CAPTURE_PTS_JUMP_S=60.0
# Fraction of the frame that must change in one step to count as a hard cut.
ANPR_SCENE_CUT_FRACTION=0.55

# --- analytics sizing --------------------------------------------------
# Smallest vehicle worth reading, as a fraction of frame area. A fraction, not
# a pixel count: the grid mixes resolutions and one pixel count means different
# things on different cameras.
ANPR_MIN_VEHICLE_FRACTION=0.001
ANPR_MIN_VEHICLE_AREA_PX=600

# --- describing vehicles that cannot be read --------------------------
# Colour and coarse class for every tracked vehicle, whether or not a plate was
# read. On by default: 0 of the 30 government cameras reach ANPR grade, so on
# most of the estate this is the only description of a vehicle there will ever
# be. Off is a real option — it is the one stage whose output volume does not
# depend on how many plates were read.
ANPR_DESCRIBE_VEHICLES=on
# Share of visible bodywork the winning colour must hold before it is named at
# all. Below this the crop is too mixed, too dark or too small to support a
# name, and no colour is recorded rather than a guess.
ANPR_MIN_COLOUR_CONFIDENCE=0.35
# How far ahead of the best *unrelated* colour the winner must be. This is what
# refuses a genuinely two-tone vehicle, which clears any absolute floor worth
# setting. Unrelated, because white/silver/grey are the same paint under
# different light and a real car spreads across all three.
ANPR_MIN_COLOUR_MARGIN=0.10

# --- heavy models as a fallback ---------------------------------------
# A camera reading fewer than this share of its tracked vehicles, over this
# many tracks, is moved up to the heavy models — that camera only.
ANPR_ESCALATE_READ_FLOOR=0.15
ANPR_ESCALATE_MIN_SAMPLE=25
# How much better heavy must be before the escalation is kept.
ANPR_ESCALATE_IMPROVEMENT=1.5
# Cameras allowed to run heavy models at once, per worker process.
ANPR_ESCALATE_BUDGET=2

# --- OCR boost: PaddleOCR-VL on cameras an operator picks -------------
# POST /api/ocr-boosts. Needs the GPU worker image; on the lean image a boost
# reports `failed` with the reason. The demo on this machine uses:
#ANPR_DOCKERFILE=services/anpr/Dockerfile.gpu
#ANPR_VEHICLE_BACKEND=motion       # keep the motion tracker on the GPU image
# How often workers look for new or ended boosts, in seconds.
ANPR_OCR_BOOST_REFRESH_S=5
# Most cameras boosted at once (each boosted crop holds an OCR slot ~440 ms).
OCR_BOOST_MAX_CAMERAS=12

# --- plate normalisation ----------------------------------------------
# Derived OCR confusion table. Absent, the built-in prior is used.
# Regenerate with: make confusion
OCR_CONFUSION_PATH=data/ocr-confusion.json
# Place-name gazetteer used to position cameras the catalogue gives a location
# name but no coordinates for.
GAZETTEER_PATH=data/gazetteer/gujarat.json

# --- hosted deployment ------------------------------------------------
# Only needed for a public instance. See docs/hosting.md.
#
# The public URL, no trailing slash. This is where the *browser* fetches the
# app, the API and video, so it must be the address a stranger would type —
# not localhost, not a container name. Get it wrong and the app loads, the map
# draws, and video silently fails.
PUBLIC_ORIGIN=

# Which transport the browser plays live video over: webrtc (default) or hls.
#
# A deployment fact, not a preference. WebRTC is much lower latency and is right
# whenever the browser can reach the media server directly. But its media rides
# UDP, and an HTTP-only path in front of the platform — a tunnel, a corporate
# proxy, the "restricted network" the integration contract names — carries the
# WHEP signalling perfectly and then starves the ICE negotiation: the session
# establishes and no frame ever paints. docker-compose.hosted.yml sets `hls`.
MEDIA_TRANSPORT=webrtc

# Cloudflare Tunnel token, from the Zero Trust dashboard. A CREDENTIAL: anyone
# holding it can serve traffic as your tunnel. Never commit it, never leave it
# on screen in a demo recording.
TUNNEL_TOKEN=

# Where the hosted stack binds locally. The tunnel reaches nginx over the
# compose network, so loopback is the right default — a hosted instance should
# not also be listening on every interface of the machine.
HOST_BIND=127.0.0.1
HOST_PORT=8080

# --- the government camera grid ---------------------------------------
# The documented entry point. It 301s to wherever the estate currently lives
# (cctv.corp8.cloud as of 31 Aug 2026, having moved twice that day), and the
# platform resolves stream paths against whichever host answers — so this stays
# correct across their moves. Point it directly at the new host to save a hop.
SENTINEL_BASE=https://live.sentinelgujarat.in

# Access password for the grid portal, issued on registration at
# <grid>/auth/register. Format XXXX-XXXX-XXXX.
#
# A CREDENTIAL. Environment only, never a file git tracks (invariant 5) — this
# repository is a submission artifact and will be read by evaluators. Without
# it, onboarding refuses with exit code 2 and tells you where to register; it
# never half-applies.
SENTINEL_ACCESS_PASSWORD=
# The email the access password was registered to. Since 14 Sep 2026 the login
# form wants both; the password alone lands back on the login page.
SENTINEL_ACCESS_EMAIL=

# Login for the grid's RTSP video. Without it every stream answers 401; with the
# same registered email and access code it serves 1920x1080 H.264. Onboarding
# stores only the REFERENCE ("sentinel") on each camera; the values below are read
# at connect time by services/adapters/credentials.py and are never stored or
# logged. The grid's HLS answers "browser required" to software, so RTSP is the
# route for the platform.
SENTINEL_CREDENTIAL_REF=sentinel
CAMERA_CRED_SENTINEL_USER=
CAMERA_CRED_SENTINEL_PASSWORD=

# --- optional analytics -----------------------------------------------
# Face DETECTION beside ANPR. Off unless explicitly set to 1/true/yes/on.
#
# It never identifies anyone: no gallery, no enrolment, no name returned. It
# exists to demonstrate that the edge pipeline takes analytics modules as
# plugins, and is demonstrated on drawn synthetic faces only — never on a
# government feed or a recording of a real person.
#
# Deploying facial recognition against public CCTV raises live questions under
# the DPDP Act 2023 and India has no settled framework for it. Enabling this
# needs a lawful authorisation regime, per-query case binding and an audit entry
# per query. Read the module docstring in services/analytics/ before enabling.
FRS_ENABLED=false

# --- appearance matching (the `attribute` alert tier) -----------------
# How long a plate match keeps corroborating appearance matches for the same
# watchlist entry. This window is the whole safety property of the tier: an
# appearance match is raised ONLY for an entry whose plate was matched inside
# it, so a description can extend a trace but can never start one. Ten minutes
# is roughly 10 km at the speeds these corridors carry. Lengthen it and you
# have built a colour alarm.
ALERT_CORROBORATION_WINDOW_S=600

# --- which cameras an ANPR worker owns ---------------------------------
# Comma-separated `external_ref` patterns, `*` is a wildcard. Empty (the
# default) means every camera, which is what a single-site deployment wants.
#
# Different axis from ANPR_SHARDS. Sharding splits the estate *evenly*; this
# says which cameras are in scope at all, and is applied first — so N workers
# still split what is in scope rather than three of them owning nothing.
#
# Two uses. An edge worker should be scoped to the cameras its site can
# physically reach: a worker at Bharuch has no business decoding Rajkot. And
# recording a demo: decoding 50 cameras to film 6 put this 20-core box at load
# 22 with ~1% of sightings carrying a plate; 9 cameras gives load 5 and 96-100%.
#
# This is NOT decommissioning. Every camera stays registered, on the map and in
# the health history. It says only "not this worker's to decode".
#ANPR_CAMERA_REFS=cam-2*,sentinel-cam1*
