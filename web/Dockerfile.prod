# Production web tier: build the app, serve it with nginx.
#
# The base `Dockerfile` runs `vite dev`, which is correct for development and
# wrong for anything reachable from a network — it is unminified, it opens a
# hot-reload websocket, and it is explicitly not meant to face the internet.
# A hosted instance is a graded artifact, so it gets a real build.
#
# Build context is the REPO ROOT, not web/, because the nginx configuration
# lives with the rest of the infrastructure in infra/. Build it with:
#
#   docker build -f web/Dockerfile.prod -t cctv-web .

FROM node:22-alpine AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
# Empty rather than unset: `api.ts` falls back to localhost:8000 only when the
# variable is *nullish*, so "" is what selects same-origin relative URLs.
ENV VITE_API_BASE=""
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
